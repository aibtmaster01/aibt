# 브랜드/기능 (복사해 .env.production / .env.beta 로 사용)
# 실서버: .env.production 또는 생략 시 기본값(핀셋) 적용
# 베타: .env.beta 생성 후 npm run build:beta (또는 검수/오픈베타는 아래 스크립트)
#   VITE_APP_BRAND=AiBT
#   VITE_FEATURE_COUPON=true|false
# 오픈 베타·스토어 검수 배포(쿠폰 off): npm run deploy:beta:review

VITE_APP_BRAND=핀셋
VITE_FEATURE_COUPON=false
